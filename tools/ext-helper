#!/bin/bash -ex
# Build helper for the extensions fork, specific to a macOS + Homebrew setup.
#   tools/ext-helper bootstrap   configure from scratch into build/
#   tools/ext-helper install     build and install into local/
#   tools/ext-helper clean       remove the objects
# If the default Command Line Tools SDK is broken, export SDKROOT first, e.g.
#   export SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk

function bootstrap()
{
  rm -rf build
  mkdir -p build
  ./autogen.sh
  cd build

  # Homebrew on Apple Silicon is not on the compiler's default search paths
  BREW=$(brew --prefix)
  export CC=gcc
  export CFLAGS="-g"
  export CPPFLAGS="-I$BREW/include"
  export LDFLAGS="-L$BREW/lib -L$BREW/opt/quickjs/lib/quickjs"

  ../configure --prefix "$PWD/../local" \
    --with-video=sdl --with-opengl --enable-opengl-by-default \
    --enable-monitorbreakpoints --enable-monitorprofile --enable-monitortrace \
    --enable-seriosound \
    --with-sound=sdl --with-ext
  cd -
}

install()
{
  make -C build -j 8 install
}

clean()
{
  # upstream's "make clean" fails in an out-of-tree build directory
  find build -name '*.o' -delete
}

"$1"
